{
  "name": "zotero-fig",
  "type": "module",
  "version": "0.1.1",
  "description": "Identify figures and tables in Zotero PDF reader and provide navigation and preview UI.",
  "config": {
    "addonName": "Zotero Fig",
    "addonID": "zoterofig@forgeters.github.io",
    "addonRef": "zoterofig",
    "addonInstance": "ZoteroFig",
    "prefsPrefix": "extensions.zotero.zoterofig"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forgeters/zotero-fig.git"
  },
  "author": "forgeters",
  "bugs": {
    "url": "https://github.com/forgeters/zotero-fig/issues"
  },
  "homepage": "https://github.com/forgeters/zotero-fig#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "mocha": "^11.7.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
